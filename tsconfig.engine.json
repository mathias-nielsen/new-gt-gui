{
    "compilerOptions": {
        "target": "ES2022",
        "module": "node16",
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "./dist-electron",
        "rootDir": ".",
        "sourceMap": true,
        "types": ["node"]
    },
    "include": ["main.ts", "backend/**/*.ts", "shared/**/*.ts"]
}
